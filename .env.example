# Copiez ce fichier en ".env" (ignoré par Git) et renseignez votre clé.
#   copy .env.example .env
# Ne partagez jamais la clé et ne la commitez jamais.

# --- Clé API du fournisseur LLM (https://console.groq.com/keys) ---
GROQ_API_KEY=

# --- Choix du LLM (init_chat_model) ---
# Fournisseur : groq (défaut). Autres valeurs possibles si le paquet
# langchain-<fournisseur> correspondant est installé : openai, anthropic, mistralai...
LLM_PROVIDER=groq
# Modèle : liste à jour sur https://console.groq.com/docs/models
LLM_MODEL=openai/gpt-oss-20b

# --- Réglages facultatifs ---
# LLM_ENABLED=true            # false = désactive toute génération (pipeline sans LLM)
# LLM_TEMPERATURE=0
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_RETRIES=2
# LLM_MAX_TOKENS=800
# LLM_ANSWER_LANGUAGE=French  # langue de la réponse rédigée
